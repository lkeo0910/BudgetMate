# Project Settings
PROJECT_NAME="BudgetMate"

# Database and Redis
DATABASE_URL="postgresql://user:password@localhost:5432/budgetmate"
REDIS_URL="redis://localhost:6379/0"

# Security (Change these in production!)
SECRET_KEY="your-secret-key-goes-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email SMTP (Gmail, SendGrid, Mailtrap, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAILS_FROM_EMAIL="your-email@gmail.com"
EMAILS_FROM_NAME="BudgetMate"

# OCR
OCR_SPACE_API_KEY="your-ocr-space-api-key"

# AI Agent (Google Gemini)
GOOGLE_API_KEY="your-google-ai-api-key"

# MongoDB
MONGODB_URL="mongodb://admin:password@127.0.0.1:27018/?authSource=admin&directConnection=true"
MONGODB_DB_NAME="budgetmate"

# LangSmith Tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your-langsmith-api-key"
LANGSMITH_PROJECT="BudgetMate"
